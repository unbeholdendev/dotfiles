{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "impeccable@impeccable": false,
    "taste-skill@taste-skill": true
  },
  "extraKnownMarketplaces": {
