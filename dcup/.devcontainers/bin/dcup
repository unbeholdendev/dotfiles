#!/usr/bin/env bash
set -euo pipefail

command -v devcontainer >/dev/null ||
  { echo "no devcontainer CLI: npm i -g @devcontainers/cli" >&2; exit 1; }

# The same trick the `dots` function uses, so the path is right on any host.
f=$(readlink -f ~/.zshrc)
dotfiles=${DOTFILES:-${f%/*/*}}

# Off by default: that credential is worth more to the other people in a shared
# project than the MCP server is to you.
token=0
if [[ ${1:-} == --token ]]; then token=1; shift; fi

folder=${1:-.}

# Shell history outlives the container it was typed in, one store per project.
state=$HOME/.devcontainer-state/$(basename "$(readlink -f "$folder")")
mkdir -p "$state"

# installOhMyZshConfig writes a ~/.zshrc, and stow will not link over a regular
# file, so leaving it on makes the zsh package silently do nothing.
#
# --no-lockfile because the CLI otherwise writes devcontainer-lock.json into the
# project it starts, and that tree is not ours to dirty. It pins nothing here:
# the features are on this command line rather than in a devcontainer.json.
devcontainer up --workspace-folder "$folder" --no-lockfile \
  --additional-features '{"ghcr.io/devcontainers/features/common-utils:2":{
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false }}' \
  --mount "type=bind,source=$dotfiles,target=/dotfiles" \
  --mount "type=volume,source=mise-store,target=/mise" \
  --mount "type=bind,source=$state,target=/history" \
  --mount "type=volume,source=claude-state,target=/claude" \
  "${@:2}"

devcontainer exec --workspace-folder "$folder" /dotfiles/install.sh container

# A copy and not a mount: `--mount` takes only type, source, target and
# external, so a read-only bind is not expressible, and a copy follows `$HOME`
# in a project that runs as its own user. The identity travels with the token,
# because a project that gets neither keeps the git config it already has.
if (( token )) && [[ -r ~/.forgejo-token ]]; then
  devcontainer exec --workspace-folder "$folder" \
    sh -c 'umask 077; cat > "$HOME/.forgejo-token"' < ~/.forgejo-token

  devcontainer exec --workspace-folder "$folder" sh -s <<'EOF'
git config --global user.name agent
git config --global user.email 335420059+unbeholdendev@users.noreply.github.com
git config --global credential.https://git.home.unbeholden.dev.helper \
  '!f() { echo username=agent; echo "password=$(cat "$HOME/.forgejo-token")"; }; f'
EOF
fi
