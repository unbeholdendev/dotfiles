#!/usr/bin/env bash
set -euo pipefail

command -v devcontainer >/dev/null ||
  { echo "no devcontainer CLI: npm i -g @devcontainers/cli" >&2; exit 1; }

folder=${1:-.}

# The agent runs out of the process tree herdr reads, so HERDR_AGENT labels it
# here. Through zsh, because .zshenv is what puts the profile on PATH.
exec env HERDR_AGENT=pi devcontainer exec --workspace-folder "$folder" \
  zsh -c 'exec pi "$@"' pi "${@:2}"
