#!/usr/bin/env bash
set -euo pipefail

command -v devcontainer >/dev/null ||
  { echo "no devcontainer CLI: npm i -g @devcontainers/cli" >&2; exit 1; }

dotfiles=${DOTFILES:-}
[[ -n $dotfiles ]] ||
  { echo "no DOTFILES: run dots on this host to write ~/.dots-path" >&2; exit 1; }

folder=${1:-.}

# The basename alone is not unique: two clones of one name would share a history.
resolved=$(readlink -f "$folder")

# A container that exists already holds the token it was built with.
forge=
if [[ -t 0 ]] &&
  ! docker ps -aq --filter "label=devcontainer.local_folder=$resolved" | grep -q .
then
  PS3='which token for this container? '
  select forge in none forgejo github; do [[ -n $forge ]] && break; done
  case ${forge:-none} in none) forge= ;; esac
fi

token=~/.$forge-token

# Before the pull, so an hour of it does not end in a container that cannot push.
if [[ -n $forge && ! -f $token ]]; then
  echo "no $token on this host" >&2; exit 1
fi

stamp=$(printf %s "$resolved" | md5sum | cut -c1-8)
state=$HOME/.devcontainer-state/$(basename "$resolved")-$stamp
mkdir -p "$state"

browser=$state/t3-browser
if [[ -t 0 && ! -f $browser ]]; then
  read -rp 'enable the T3 browser here? As root it runs unsandboxed. [y/N] ' answer
  if [[ $answer == [yY]* ]]; then echo yes > "$browser"; else echo no > "$browser"; fi
fi
browser_env=()
if [[ -f $browser && $(<"$browser") == yes ]]; then
  browser_env=(--remote-env T3_BROWSER=1)
fi

# Root, because the shared /nix volume belongs to root.
if [[ ! -d $folder/.devcontainer && ! -e $folder/.devcontainer.json ]]; then
  cat > "$folder/.devcontainer.json" <<'EOF'
{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "root"
}
EOF
  if exclude=$(git -C "$folder" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null); then
    mkdir -p "$(dirname "$exclude")"
    grep -qsxF .devcontainer.json "$exclude" || echo .devcontainer.json >> "$exclude"
  fi
fi

remotes=$(git -C "$folder" config --local --get-regexp '^remote\..*\.url$' 2>/dev/null || true)

owner=
if [[ $remotes == *github.com* && -f ~/.github-token ]]; then
  owner=$(curl -fsS --max-time 10 -H @- https://api.github.com/user \
    <<<"Authorization: Bearer $(<~/.github-token)" | jq -r .login) ||
    echo "no owner for ~/.github-token: its repos count as foreign" >&2
fi

foreign=
while read -r _ url; do
  [[ $url =~ ^(https://|ssh://git@|git@)git\.home\.unbeholden\.dev[/:] ]] && continue
  [[ -n $owner && $url =~ ^(https://|ssh://git@|git@)github\.com[/:]([^/]+)/ &&
    ${BASH_REMATCH[2]} == "$owner" ]] && continue
  [[ -n $url ]] && foreign=1
done <<<"$remotes"

# The CLI's --mount rejects readonly. --no-hardlinks, or root in the container
# could write through to the host clone's objects. Outside $state, which the
# container can write: it could swap the clone for a link to the host clone.
if [[ -n $foreign ]]; then
  [[ -d $state.dotfiles ]] || git clone -q --no-hardlinks "$dotfiles" "$state.dotfiles"
  dotfiles=$state.dotfiles
fi

# installOhMyZshConfig writes a ~/.zshrc, which home-manager then refuses to
# replace. --no-lockfile, or the CLI dirties the project with a lock file.
devcontainer up --workspace-folder "$folder" --no-lockfile \
  --additional-features '{"ghcr.io/devcontainers/features/common-utils:2":{
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false }}' \
  --mount "type=bind,source=$dotfiles,target=/dotfiles" \
  --mount "type=volume,source=nix-store,target=/nix" \
  --mount "type=bind,source=$state,target=/history" \
  --mount "type=volume,source=claude-state,target=/claude" \
  --mount "type=volume,source=codex-state,target=/codex" \
  "${@:2}"

container=$(docker ps -q --filter "label=devcontainer.local_folder=$resolved")

# Applied after up so it also covers a project's own devcontainer config. Swap
# equal to memory means none: a runaway is killed instead of thrashing the host.
docker update --memory 3g --memory-swap 3g --cpus 4 --pids-limit 4096 "$container" >/dev/null

devcontainer exec --workspace-folder "$folder" "${browser_env[@]}" \
  /dotfiles/install.sh container

# T3 Code names a server after this, or else the container's random hostname.
printf 'PRETTY_HOSTNAME=%s\n' "$(basename "$resolved")" |
  docker exec -i -u root "$container" sh -c 'cat > /etc/machine-info'

# Not t3 serve: it never adds the workspace as a project, so threads land in a
# scratch folder. The lock turns a rerun into a no-op while the server lives.
# Its output holds pairing details, so it goes nowhere; T3 Code keeps its logs.
# Chrome has no sandbox as root, and T3's browser refuses to start without this.
# With the lock held no server lives, yet a rebuild can reuse the recorded PID,
# and t3 start then refuses to run.
devcontainer exec --workspace-folder "$folder" "${browser_env[@]}" zsh -c '
  [[ -n $T3_BROWSER ]] && export T3CODE_SERVER_BROWSER_SANDBOX=$((EUID != 0))
  T3CODE_TELEMETRY_ENABLED=false setsid -f flock -n /history/t3.lock zsh -c "
    rm -f /history/t3/userdata/server-runtime.json
    exec t3 start --no-browser --host 0.0.0.0 --port 3773 --base-dir /history/t3" \
    </dev/null >/dev/null 2>&1'

ports=$HOME/.devcontainer-state/t3-ports
mkdir -p "$ports"
exec 9>"$ports/.lock"
flock 9
port=$(grep -lxF -- "$resolved" "$ports"/* 2>/dev/null || true)
port=${port##*/}
if [[ -z $port ]]; then
  port=37731
  while [[ -e $ports/$port ]] || (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; do
    port=$((port + 1))
  done
  echo "$resolved" > "$ports/$port"
fi
exec 9>&-

# The container is looked up per connection because a rebuild changes its IP. A
# forward left from an earlier run holds the port, so this one exits.
T3_FOLDER=$resolved setsid -f socat "TCP-LISTEN:$port,fork,reuseaddr" \
  'SYSTEM:"exec socat - TCP4:$(docker inspect -f \"{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}\" $(docker ps -q --filter label=devcontainer.local_folder=\"$T3_FOLDER\")):3773"' \
  </dev/null >/dev/null 2>&1

echo "t3: http://$(hostname -I | cut -d' ' -f1):$port, pair with: dcpair $(printf %q "$folder")"

case $forge in
  forgejo)
    devcontainer exec --workspace-folder "$folder" \
      sh -c 'umask 077; cat > "$HOME/.forgejo-token"' < ~/.forgejo-token

    devcontainer exec --workspace-folder "$folder" sh -s <<'EOF'
git config --global user.name agent
git config --global user.email 335420059+unbeholdendev@users.noreply.github.com
git config --global credential.https://git.home.unbeholden.dev.helper \
  '!f() { echo username=agent; echo "password=$(cat "$HOME/.forgejo-token")"; }; f'
EOF

    # Through zsh, because .zshenv is what puts the profile on PATH.
    devcontainer exec --workspace-folder "$folder" zsh -c '
      GITEA_SERVER_TOKEN=$(<"$HOME/.forgejo-token") tea login add --name forgejo \
        --url https://git.home.unbeholden.dev >/dev/null ||
        echo "tea login failed: T3 Code cannot read Forgejo PRs here" >&2'
    ;;
  github)
    devcontainer exec --workspace-folder "$folder" \
      sh -c 'umask 077; cat > "$HOME/.github-token"' < "$token"

    devcontainer exec --workspace-folder "$folder" sh -s <<'EOF'
git config --global credential.https://github.com.helper \
  '!f() { echo username=x-access-token; echo "password=$(cat "$HOME/.github-token")"; }; f'
EOF

    # Nothing else gives a GitHub container a git identity.
    devcontainer exec --workspace-folder "$folder" zsh -c '
      gh auth login --with-token < "$HOME/.github-token" &&
        read -r id login < <(gh api user --jq "[.id, .login] | @tsv") &&
        git config --global user.name "$login" &&
        git config --global user.email "$id+$login@users.noreply.github.com" ||
        echo "gh login failed: T3 Code cannot read GitHub PRs here, and commits keep the host identity" >&2'
    ;;
esac
