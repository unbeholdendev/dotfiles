{
  "mcpServers": {
    "forgejo": {
      "command": "forgejo-mcp",
      "args": ["--transport", "stdio", "--url", "https://git.home.unbeholden.dev"],
      "env": { "FORGEJO_ACCESS_TOKEN": "!cat \"$HOME/.forgejo-token\"" },
      "description": "Forgejo at git.home.unbeholden.dev: issues, pull requests, repositories"
    }
  }
}
